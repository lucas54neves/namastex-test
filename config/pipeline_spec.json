    "safe_auto_apply_playbooks": [
      "rebuild_silver_from_bronze",
      "rebuild_gold_from_silver",
      "quarantine_invalid_records",
      "fallback_to_last_successful_artifacts"
    ],
    "planner": {
      "proposal_defaults": {
        "recommendation_only": true,
        "default_status": "proposed"
      }
    }
  },
  "llm": {
    "enabled": false,
    "prompt_version": "v1",
    "timeout_seconds": 20,
    "max_retries": 1,
    "langfuse": {
      "enabled": false,
      "prompt_name": "conversation-enrichment-v1",
      "prompt_label": "production",
      "trace_name": "conversation-enrichment",
      "allow_local_prompt_fallback": true
    },
    "providers": {
      "openai": {
        "enabled": true,
        "role": "primary",
        "model": "gpt-5-mini"
      },
      "anthropic": {
        "enabled": true,
        "role": "fallback",
        "model": "claude-sonnet"
      }
    }
